    "scenes": [
      {
        "index": 1,
        "start_line": 3,
        "end_line": 59,
        "location": "君来乡第五军军部作战室",
        "summary": "参谋本部送来修订版瓦尔基里行动，第五军接令后须进城控制三山门、光淮门、城南电报局。军长令当夜拟好命令封存，邱深澳负责三山门一路，画到城门时想到这条路将来可能用来堵城里起事的人。",
        "characters": [
          "fifth_army_commander",
          "fifth_army_chief_of_staff",
          "qiu_shenao"
        ],
        "content": "修订版瓦尔基里行动送达；第五军进城任务；邱深澳负责三山门一路"
      },
      {
        "index": 2,
        "start_line": 61,
        "end_line": 121,
        "location": "第五军营房、通讯连",
        "summary": "邱深澳收到第三处传票和邱思甜不落款的来信，约他进京到王府相见。同僚担心进去出不来。天亮前他到通讯连交代连长：天黑前不回，就把那本东西烧掉。",
        "characters": [
          "qiu_shenao",
          "colleague_fifth_army",
          "signal_company_commander"
        ],
        "content": "第三处传票；邱思甜来信；交代通讯连长烧那本东西"
      },
      {
        "index": 3,
        "start_line": 123,
        "end_line": 157,
        "location": "官道、三山门、第三处前院",
        "summary": "两人坐马车进城，石桥过得了炮车。三山门由神策军加倍把守，看到第三处黑印便放行。城里铺子大半关门，虎贲骑兵巡街。第三处前院挤满近卫军军官，为封枪骂骂咧咧。",
        "characters": [
          "qiu_shenao",
          "colleague_fifth_army"
        ],
        "content": "进城所见；第三处前院近卫军抱怨封枪"
      },
      {
        "index": 4,
        "start_line": 159,
        "end_line": 267,
        "location": "第三处审讯室及门外",
        "summary": "审讯员只问那辆车、副官和外交部的人、太子身边的人和近卫军军服，没问中庆和第五军。邱深澳签押出门，一身冷汗，觉得风头像是没刮到他们，但还得再看。他支开同僚，去看一个人。",
        "characters": [
          "qiu_shenao",
          "disanchu_shenxunyuan",
          "colleague_fifth_army"
        ],
        "content": "录口供；第三处问讯重点在太子一线；邱深澳的判断"
      },
      {
        "index": 5,
        "start_line": 269,
        "end_line": 299,
        "location": "王府邱思甜卧房",
        "summary": "邱思甜在王府卧床养伤，王思涵严令丫头看住她。她惦记着住院的秘书和副官签过字、如今压在参谋本部的停战草稿。门房来报邱少校到了，她不顾劝阻下床去偏厅。",
        "characters": [
          "qiu_sitian",
          "wangfu_yatou",
          "wangfu_menfang"
        ],
        "content": "邱思甜养伤；停战草稿下落不明；邱深澳来访"
      },
      {
        "index": 6,
        "start_line": 301,
        "end_line": 411,
        "location": "王府偏厅",
        "summary": "两人以中庆话叙旧，邱深澳告诉她第三处在查太子一线，劝她离京、别再碰草稿。两人为停战和中庆起义争执，她说漏嘴后后悔，他说“我要你活着”。问起妹妹，他说已无消息。临别约好写信。",
        "characters": [
          "qiu_shenao",
          "qiu_sitian"
        ],
        "content": "重逢、争执、妹妹下落、约定写信"
      },
      {
        "index": 7,
        "start_line": 413,
        "end_line": 461,
        "location": "灵武大街布庄临时医疗点",
        "summary": "王思涵安置神圣高地伤员，承诺抚恤由首相府先垫、记在她名下，又听到有人议论她靠父亲撑腰。议员领来卖炭汉子，作证出事当天早上有六辆“通泰”马车经过西坡，而第三处和内务本部从没人问过他。",
        "characters": [
          "wang_sihan",
          "jingzhaofu_zhubu",
          "assembly_member",
          "maitan_hanzi"
        ],
        "content": "伤员安置；通泰马车人证"
      },
      {
        "index": 8,
        "start_line": 463,
        "end_line": 499,
        "location": "户部签押房",
        "summary": "户部侍郎查到通泰商会在德裕银号开户。王思涵连夜翻账，发现腊月一大笔汇票兑出的银子被三笔全数提走，分毫不差；而开汇票的那家北方票号账上根本没有这笔钱。",
        "characters": [
          "wang_sihan",
          "vice_minister_of_revenue"
        ],
        "content": "德裕银号账目；汇票来源不存在"
      },
      {
        "index": 9,
        "start_line": 501,
        "end_line": 569,
        "location": "王府邱思甜卧房、偏厅",
        "summary": "王思涵深夜回府，得知邱思甜下床见过邱少校。邱思甜说第三处在查太子一线，并坚持明日去参谋本部取回草稿。王思涵拗不过，答应派马车和护院相送。偏厅里两只茶碗，一只空着一只满着，她吹灭了灯。",
        "characters": [
          "wang_sihan",
          "qiu_sitian",
          "wangfu_menfang"
        ],
        "content": "邱思甜决意明日赴参谋本部；王思涵安排护送"
      }
    ],
    "chapter_meta": {},
    "dominant_strand": "",
    "summary_text": "修订版瓦尔基里行动送达第五军，邱深澳负责进城的三山门一路。他奉第三处传票进城录口供，进城前交代通讯连长天黑不归就烧掉那本东西；第三处只问太子副官和外交部。他到王府见邱思甜，两人为停战草稿与中庆起义争执。王思涵得到通泰马车的人证，又查出德裕银号的汇票来源在账上不存在。邱思甜决意明日去参谋本部取回草稿。"
  },
