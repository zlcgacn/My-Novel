    "scenes": [
      {
        "index": 1,
        "start_line": 3,
        "end_line": 17,
        "location": "灵武军营房·军械库",
        "summary": "第三处与参谋本部封存灵武军枪械，周君州压下邓声宝的不满",
        "characters": [
          "zhou_junzhou",
          "deng_shengbao"
        ],
        "content": "夜里第三处探员与参谋本部军械官到灵武军营房逐库贴封条。邓声宝不服，周君州以圣旨为由令谁也不许拦、不许碰。他在封好的枪柜前站了片刻，嘱邓声宝看营，自己回家。"
      },
      {
        "index": 2,
        "start_line": 19,
        "end_line": 53,
        "location": "京城街道→周府前院",
        "summary": "宵禁中回府，偶遇王氏父女，问邱思甜近况，周君瑶见王思涵后噤声",
        "characters": [
          "zhou_junzhou",
          "wang_zhengyan",
          "wang_sihan",
          "zhou_junyao"
        ],
        "content": "京城宵禁，虎贲军巡夜。周府门前遇王政炎携王思涵来访。王思涵告知内禁医院挨炸，邱思甜已接回王家，伤口微裂无大碍，张艺宣陪了一下午。二人斗嘴。周君瑶跑来关心哥哥，见王思涵便噤声回房。"
      },
      {
        "index": 3,
        "start_line": 55,
        "end_line": 131,
        "location": "周府花厅",
        "summary": "改良派密会，各执一词后由周世衡定调自查真凶并分工",
        "characters": [
          "zhou_shiheng",
          "wang_zhengyan",
          "zhou_junzhou",
          "wang_sihan",
          "first_guards_army_commander",
          "vice_minister_of_revenue",
          "wenli_professor",
          "assembly_member"
        ],
        "content": "数人缺席。军长要先揪近卫军内鬼，户部侍郎想趁机削军费，教授忧第三处清查舆论，议员说议会无权过问治安。周世衡转述太子“先保住人”，定下自查真凶；周君州透露新年夜案有军中人参与，众人分领线索，约定守密。"
      },
      {
        "index": 4,
        "start_line": 133,
        "end_line": 155,
        "location": "周府门前",
        "summary": "散会送别，王周约定互通消息，周君州托问候邱思甜",
        "characters": [
          "zhou_junzhou",
          "wang_sihan",
          "wang_zhengyan"
        ],
        "content": "近子时散会，无腰牌的客人留宿周府。王思涵临上车约定商会查到军中之人先告诉周君州，周君州允以灵武军所得相报，又托她问候邱思甜、叫她别急着下床，并要她照实转达。马车远去，京城一片死寂。卷一完。"
      }
    ],
