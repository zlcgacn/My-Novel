    "scenes": [
      {
        "index": 1,
        "start_line": 3,
        "end_line": 23,
        "location": "京城通往君来乡的大道（羽林军军用马车上）",
        "summary": "卯初，邱深澳与同僚乘马车回第五军驻地。同僚埋怨他硬闯内禁医院，追问他要见谁，又说外交部长是灵武军军长下令送进内禁医院的。邱深澳不答，痛斥贵族盘剥农民；同僚问他为何加入羽林军，他沉默睡去。",
        "characters": [
          "qiu_shenao",
          "colleague_fifth_army"
        ],
        "content": "现实线：返程马车上的对话，引出回忆。时间：卯初，参谋本部遇袭后五小时。"
      },
      {
        "index": 2,
        "start_line": 25,
        "end_line": 46,
        "location": "中庆省（中庆城）",
        "summary": "插叙八年前：中庆大旱，帝国陷于第八次西北战争，反加粮税。十六岁的邱深澳停学教书谋生，父亲被征粮官杀害，母亲和奶奶饿死，妹妹下落不明。饥民起义，三天聚众十万，他加入起义军当了传令兵。",
        "characters": [
          "qiu_shenao"
        ],
        "content": "回忆：家破人亡与中庆起义爆发。"
      },
      {
        "index": 3,
        "start_line": 47,
        "end_line": 58,
        "location": "中庆岛；无名高地下",
        "summary": "大陆援军到来，帝国出动皇家捍卫者军团和两个死亡骑兵营镇压。起义军靠游击屡胜而轻敌。第八天，起义军引出一个由少年军官率领的帝国连队，两万余人把退守无名高地的这支连队团团围住。",
        "characters": [
          "qiu_shenao",
          "zhou_junzhou"
        ],
        "content": "回忆：起义军轻敌，围住无名高地。"
      },
      {
        "index": 4,
        "start_line": 59,
        "end_line": 83,
        "location": "无名高地",
        "summary": "起义军两批强攻被马克沁机枪和集束手榴弹打退，死伤数千。第三批集结时，死亡骑兵从高地南面背后突袭，将起义军反包围屠戮殆尽。邱深澳在高地上随幸存者投降被俘，后从档案得知那个连本是帝国军的诱饵。",
        "characters": [
          "qiu_shenao",
          "zhou_junzhou"
        ],
        "content": "回忆：无名高地之战，起义军覆灭，邱深澳被俘。"
      },
      {
        "index": 5,
        "start_line": 85,
        "end_line": 93,
        "location": "帝国荒地（赎罪军团开垦地）",
        "summary": "邱深澳认识到一盘散沙、缺枪少炮又缺少知识的民众打不赢这个崇尚军事的帝国。后来皇帝特赦犯人组成两个赎罪军团，他进了开荒的那一支，在鞭子和烈日下活了下来：只要活着，就一切都还有希望。",
        "characters": [
          "qiu_shenao"
        ],
        "content": "回忆：战后反思与赎罪军团开荒。"
      }
