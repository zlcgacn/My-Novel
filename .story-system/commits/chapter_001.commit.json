    "scenes": [
      {
        "index": 1,
        "start_line": 3,
        "end_line": 27,
        "location": "南京光淮门外驿站广场",
        "summary": "康建五十年新年夜，京城张灯结彩；一对兄弟在光淮门外放特制烟花。",
        "characters": [],
        "content": "康建五十年二月四日新年头一天，南京城灯笼彩楼遍布，今年又逢皇帝登基五十周年大庆与皇太子生辰。光淮门外驿站广场，十岁的弟弟执意亲手点燃特制烟花，点完却愣在原地，被哥哥一把拉开，烟火冲天炸开。"
      },
      {
        "index": 2,
        "start_line": 29,
        "end_line": 55,
        "location": "大明宫兴庆门城楼及楼下观礼台",
        "summary": "张永怀在城楼上俯视阅兵彩排，盯着观礼台上的周君州握紧佩剑；周君州与张艺宣并肩看彩排、闲谈。",
        "characters": [
          "zhang_yonghuai",
          "zhou_junzhou",
          "zhang_yixuan"
        ],
        "content": "张永怀倚城楼女墙俯视康建广场阅兵彩排，禁卫军方阵扛着今年试装的新式步枪。观礼台上周君州身着灵武军将官礼服，张艺宣说庆典由她广播并玩笑调侃他，欲言又止。张永怀盯着周君州低声念其名，右手死握佩剑。"
      },
      {
        "index": 3,
        "start_line": 57,
        "end_line": 107,
        "location": "南京西市至云中市街口",
        "summary": "张书淮与嬴武玥在西市吃馄饨，遇云中市演唱会人潮失控，受神策军上尉轻慢后组织疏散，避免踩踏。",
        "characters": [
          "zhang_shuhuai",
          "ying_wuyue",
          "shence_shangwei",
          "shence_shaowei"
        ],
        "content": "平民亲王张书淮与嬴武玥在西市馄饨摊，见人潮涌向云中市海外演唱会。神策军上尉认出亲王却不行礼，派两名警察带路。张书淮让嬴武玥从后巷开铺子后门放人，自己在街口登阶高喊劝人去长安大街看明灯游行，人潮散去。"
      },
      {
        "index": 4,
        "start_line": 109,
        "end_line": 121,
        "location": "南京南城门光淮门城楼",
        "summary": "明灯游行绵延长安大街；王思涵与礼部尚书争论庆典是否悬挂国教明灯，决定待与首相商议。",
        "characters": [
          "wang_sihan",
          "minister_of_rites"
        ],
        "content": "长安大街上国教信众手持明灯游行祈福。光淮门城楼上，首相府官员为庆典悬挂明灯发愁：王思涵主张顺应国教影响力悬挂，礼部尚书以皇帝是无神论者反对。王思涵散会，思考如何说服首相。"
      },
      {
        "index": 5,
        "start_line": 123,
        "end_line": 147,
        "location": "南京光淮门驿站广场",
        "summary": "邱深澳与同僚议论王思涵，失口提及外交部部长；参谋本部联络官接二人，嘲讽邱深澳，二人随其前往参谋本部。",
        "characters": [
          "qiu_shenao",
          "colleague_fifth_army",
          "liaison_officer",
          "wang_sihan"
        ],
        "content": "第五军同僚指着城楼上的王思涵，说她上书削减军人特权，传闻是外交部部长亲戚；邱深澳脱口半句又改口。参谋本部联络官前来，邱深澳抽完烟才报军衔，遭其嘲讽；同僚岔开话题递报告。邱深澳心骂其皇帝走狗，慢慢跟上。"
      }
    ],
    "chapter_meta": {},
    "dominant_strand": "",
    "summary_text": "康建五十年新年夜，南京筹备皇帝登基五十周年庆典。兴庆门城楼上，张永怀盯着观礼台上与张艺宣并肩的周君州，紧握佩剑。平民亲王张书淮受神策军上尉轻慢，仍与嬴武玥疏散云中市失控人潮。王思涵与礼部尚书争论庆典是否悬挂国教明灯。城下，少校邱深澳进京送报告，失口提及外交部部长，遭联络官嘲讽。",
