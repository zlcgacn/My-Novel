    "scenes": [
      {
        "index": 1,
        "start_line": 3,
        "end_line": 13,
        "location": "zhou_mansion",
        "summary": "周君州在书房靠了两个时辰，天亮换军装出门，在妹妹窗下停步未敲门；教授与议员宵禁一解分头离府。他骑马穿城回营，街口添了神策军岗哨。",
        "characters": [
          "zhou_junzhou",
          "wenli_professor",
          "assembly_member"
        ],
        "content": "周府清晨与穿城回营"
      },
      {
        "index": 2,
        "start_line": 15,
        "end_line": 35,
        "location": "lingwu_barracks",
        "summary": "邓声宝在营门等候，报告封条贴到后半夜、军械官不点数，自己陪弟兄坐了一宿讲前天的事。各营空手出操，步子格外整齐；周君州说让专案组查个明白。",
        "characters": [
          "zhou_junzhou",
          "deng_shengbao"
        ],
        "content": "营门汇报与空手出操"
      },
      {
        "index": 3,
        "start_line": 37,
        "end_line": 119,
        "location": "lingwu_barracks",
        "summary": "第三处三人、内务本部两人组成的专案组到营。林安华逐项盘问D67领用、库钥、打靶弹壳与军官行踪，曼桂槐以账册一一作答。第三处要带走原册，李文斌、金志文署名作保改交抄本。",
        "characters": [
          "zhou_junzhou",
          "deng_shengbao",
          "man_guihuai",
          "li_wenbin",
          "jin_zhiwen",
          "lin_anhua",
          "disanchu_lingtou_tanyuan"
        ],
        "content": "专案组议事厅问询"
      },
      {
        "index": 4,
        "start_line": 121,
        "end_line": 145,
        "location": "lingwu_barracks",
        "summary": "李文斌问如何向宫里递话，留下一句“照实写，也有个先后”。金志文报告老赵头线索未有新消息，并指出邱深澳档案空缺数年；周君州命其连同爆炸案私下续查。",
        "characters": [
          "zhou_junzhou",
          "li_wenbin",
          "jin_zhiwen"
        ],
        "content": "问询后私议与邱深澳档案疑点"
      },
      {
        "index": 5,
        "start_line": 147,
        "end_line": 175,
        "location": "changan_dajie",
        "summary": "周君瑶昨夜未眠，醒来得知哥哥已回营，便不顾管家劝阻套车赴营。沿长安大街所见铺子关门、岗哨盘查，一户人家春联下已挂白布。",
        "characters": [
          "zhou_junyao",
          "zhoufu_guanjia"
        ],
        "content": "周君瑶出府赴营"
      },
      {
        "index": 6,
        "start_line": 177,
        "end_line": 243,
        "location": "lingwu_barracks",
        "summary": "士兵围住周君瑶迎进营房，枪架空着。年轻士兵转述神圣高地之战：手枪对D67、中尉中冷枪、死亡骑兵救场，满屋叫好；周君瑶追问细节，姜汤凉了也未放下。",
        "characters": [
          "zhou_junyao",
          "queer_laobing",
          "nianqing_shibing",
          "jingweiying_shangshi"
        ],
        "content": "营房听讲神圣高地之战"
      },
      {
        "index": 7,
        "start_line": 245,
        "end_line": 269,
        "location": "lingwu_barracks",
        "summary": "专案组离营，邓声宝脸色难看。周君州出军部，见妹妹在雪地里先是责问；周君瑶说“你又在那儿”，听他说没事后，上前替他扣好刚解开的领扣。",
        "characters": [
          "zhou_junyao",
          "zhou_junzhou",
          "deng_shengbao"
        ],
        "content": "兄妹相见扣领扣"
