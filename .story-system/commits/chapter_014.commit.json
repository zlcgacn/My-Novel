    "scenes": [
      {
        "index": 1,
        "start_line": 3,
        "end_line": 30,
        "location": "灵武军营军部议事厅",
        "summary": "辰时专案组行文到营：九日辰时会同军务部用底账逐营对数D67，另附会客登记通报。周君州刮了两天没刮的胡子，曼桂槐再核抄本一支不少，约卯正送来；邓声宝要姓林的一支支听着。",
        "characters": [
          "zhou_junzhou",
          "man_guihuai",
          "deng_shengbao"
        ],
        "content": "清点行文到营；周君州心里一松；曼桂槐核抄本"
      },
      {
        "index": 2,
        "start_line": 31,
        "end_line": 50,
        "location": "灵武军营军部议事厅",
        "summary": "近午金志文从参谋本部回来：清点改在军械总库库内，账不出库；封枪当夜羽林军大元帅奏准总库交羽林军看守、库门加封。邓声宝不忿，周君州说看着好，漏枪的人最盼账没了。",
        "characters": [
          "zhou_junzhou",
          "jin_zhiwen",
          "deng_shengbao"
        ],
        "content": "羽林军看守军械总库；账不出库"
      },
      {
        "index": 3,
        "start_line": 51,
        "end_line": 103,
        "location": "灵武军营军部议事厅",
        "summary": "老赵头从后门进来报：线人六日夜死在柳条巷口，京兆府记醉后冻毙，可他沾酒即起疹、离家不到二十步。周君州令其抄验状、不许灵武军出面，金志文给老娘送钱。周君州明白底账已是唯一能开口的东西。",
        "characters": [
          "zhou_junzhou",
          "lao_zhao_tou",
          "jin_zhiwen",
          "deng_shengbao"
        ],
        "content": "老赵头首次正面出场；线人之死；线断"
      },
      {
        "index": 4,
        "start_line": 105,
        "end_line": 136,
        "location": "神圣高地西坡炭窑",
        "summary": "王思涵带首相府书办到西坡，卖炭汉子已死在窑里，京兆府记炭气熏毙。婆娘说他本要今早去首相府录供，昨天傍晚有个生面孔买炭打听马车。王思涵把丧葬记在自己名下，叫书办拟条陈抚恤。",
        "characters": [
          "wang_sihan",
          "maitan_hanzi"
        ],
        "content": "卖炭汉子之死；买炭生人打听马车；抚恤"
      },
      {
        "index": 5,
        "start_line": 137,
        "end_line": 165,
        "location": "德裕银号；北边票号京城分号",
        "summary": "德裕掌柜说经手三笔提现的伙计昨天天擦黑落水，正是她在户部翻那笔账的时候；票根上的字她认得，封好送首相府。书办回报票号管汇票的伙计七日一早回老家、去处不明。",
        "characters": [
          "wang_sihan",
          "deyu_tixian_huoji",
          "piaohao_huipiao_huoji"
        ],
        "content": "德裕伙计落水；票根送首相府；票号伙计失踪"
      },
      {
        "index": 6,
        "start_line": 167,
        "end_line": 219,
        "location": "京兆府偏厅",
        "summary": "申时王思涵在京兆府把二月五日后的命案卷宗按日子排开：卖炭的熏毙、德裕伙计落水、柳条巷跑堂冻毙、城北车行伙计劫杀。她要复验两桩，主簿说已结案、要报刑部，批不下来。她抄下名单，请卷宗先别归档。",
        "characters": [
          "wang_sihan",
          "jingzhaofu_zhubu"
        ],
        "content": "排开命案；复验受阻；抄名单"
      },
      {
        "index": 7,
        "start_line": 221,
        "end_line": 269,
        "location": "君来乡第五军通讯连里间",
        "summary": "邱深澳和通讯连长翻六日以来截下的电报：第三处传的问的全是近卫军、太子身边人和D67，没碰羽林军出身与中庆。名册没烧。邱深澳决定把断了的线接回来，只接一头，连长警告后默许。",
        "characters": [
          "qiu_shenao",
          "signal_company_commander"
        ],
        "content": "截获电报；朝廷只盯近卫军；名册未烧；只接一头"
      },
      {
        "index": 8,
        "start_line": 271,
        "end_line": 297,
        "location": "君来乡第五军通讯连里间",
        "summary": "邱深澳拿出瓦尔基里草图，选中第五军要接管的城南电报局；连长说那里有他带出来的退伍老报务员。邱深澳写了一封伪装家书，傍晚交军需处上尉，明早随军需车进城捎去。",
        "characters": [
          "qiu_shenao",
          "signal_company_commander",
          "quartermaster_captain",
          "chengnan_laobaowuyuan"
        ],
        "content": "选定城南电报局；暗信交上尉"
      },
      {
        "index": 9,
        "start_line": 299,
        "end_line": 331,
        "location": "王家门口",
        "summary": "张艺宣乘王家近卫军护着的车到王家送帖，说思甜在城南粥棚帮了一下午。鼓响时邱思甜回来，纱布汗湿翘起。王思涵袖里揣着死人名单，没骂她，替她按平纱布，打算今晚交给周君州。",
        "characters": [
          "wang_sihan",
          "zhang_yixuan",
          "qiu_sitian",
          "zhang_yixuan_family_guard",
          "wangfu_huyuan"
        ],
        "content": "王家近卫军护车送帖；邱思甜归来；王思涵按下责备"
      },
      {
        "index": 10,
        "start_line": 333,
