  "scenes": [
    {
      "index": 1,
      "start_line": 3,
      "end_line": 15,
      "location": "帝国中央社播音室",
      "summary": "张艺宣念完晨间广播，最后一条是吴訥亲王昨日起在城南寺前施粥，她今早才知表兄已熬到宵禁。值班编辑送来晚间稿，说首相府要粥棚消息连播三天，第三处通报压在最上头。",
      "characters": [
        "zhang_yixuan",
        "cns_editor"
      ],
      "content": "晨间广播；施粥消息连播三天；第三处通报送到"
    },
    {
      "index": 2,
      "start_line": 17,
      "end_line": 63,
      "location": "帝国中央社播音室",
      "summary": "张艺宣把医院里许的宴会改为十一日暖阁小聚，写帖四张；写下“君州”后揉掉改作“周将军台鉴”。她原想亲送灵武军营，读到第三处会客须报专案组登记的新通报，改叫跑差送周府、不送营里。",
      "characters": [
        "zhang_yixuan",
        "cns_runner"
      ],
      "content": "宴会改小聚；“君州”笺揉掉；看通报后改送周府"
    },
    {
      "index": 3,
      "start_line": 65,
      "end_line": 79,
      "location": "王家偏厅／王家马车",
      "summary": "邱思甜在王家听着艺宣的广播出门，遮不住纱布便作罢，丫头不肯递大衣也拗不过她。听到城南粥棚和吴訥亲王时她停了手。王家马车与两名护院送她出门，这是她伤后头一回自己办公事。",
      "characters": [
        "qiu_sitian",
        "wangfu_huyuan"
      ],
      "content": "邱思甜带伤出门；广播里听到粥棚"
    },
    {
      "index": 4,
      "start_line": 81,
      "end_line": 105,
      "location": "程明广场／宏飞楼",
      "summary": "广场爆炸处已填新土，宏飞楼换了新玻璃、门口无人。值日上尉告知太子新年夜后未再来，副官经手文书五日上午已被川椴楼机要处全部收走，二楼办公室挂了铜锁。邱思甜横穿广场往北去川椴楼。",
      "characters": [
        "qiu_sitian",
        "hongfei_duty_captain",
        "wangfu_huyuan"
      ],
      "content": "宏飞楼寻草稿未果，文书已被机要处收走"
    },
    {
      "index": 5,
      "start_line": 107,
      "end_line": 229,
      "location": "川椴楼参谋本部三楼会客室",
      "summary": "作战局将官出示盖“已泄露·作废”印的草稿，只许看、不许带、不许抄。邱思甜质问当日盖印查过谁，将官称条例是“视同”非“查实”，直言作废正好。她请将官在登记簿记下“请调未准”，出楼后不回府，转去城南。",
      "characters": [
        "qiu_sitian",
        "general_staff_ops_general",
        "general_staff_clerk",
        "wangfu_huyuan"
      ],
      "content": "草稿已按泄露作废封存；带不走抄不得；登记簿记“请调未准”"
    },
    {
      "index": 6,
      "start_line": 231,
      "end_line": 373,
      "location": "城南寺前粥棚",
      "summary": "粥棚开张第二天，粥一出锅即被抢空，伤员挤不出来。邱思甜到来，张书淮叫她“思甜”，她笑他做了事从不往外说。她调名册、劈竹签，手抖时他接笔替写；他问汉子娃的烧、铺子的炉子，劝动众人排队，两锅分领理顺粥棚。",
      "characters": [
        "qiu_sitian",
        "zhang_shuhuai",
        "ying_wuyue",
        "chengnan_temple_deacon",
        "qinwangfu_attendant",
        "wangfu_huyuan"
      ],
      "content": "互称名字；她念他写；他凭熟识劝排队；一户一签、两锅分领"
    },
    {
      "index": 7,
      "start_line": 375,
      "end_line": 415,
      "location": "城南寺前粥棚",
      "summary": "张艺宣赶到，嗔怪思甜带伤乱跑，递上小聚帖子，张书淮笑她先堵了自己的推辞。被问还请了谁，她报到“周将军”时顿了一顿，思甜笑意淡下收起帖子；她说帖子送了周府，来不来得成不一定。张书淮看在眼里不作声。",
      "characters": [
        "zhang_yixuan",
        "qiu_sitian",
        "zhang_shuhuai",
        "ying_wuyue",
        "wangfu_huyuan"
      ],
      "content": "送帖；说出请了周将军；三人各怀心事"
    },
    {
      "index": 8,
      "start_line": 417,
      "end_line": 465,
      "location": "城南寺前粥棚锅边",
      "summary": "收工后锅边只剩二人，邱思甜说出去讨草稿、草稿已作废，却不肯说上面写了什么，停战须殿下重新点头派人。张书淮只说“大哥那里，我说不上话”；她笑说没想叫他去说，只是不想回去躺着。她走后他把锅刷了三遍。",
      "characters": [
        "qiu_sitian",
        "zhang_shuhuai",
        "ying_wuyue",
        "wangfu_huyuan"
      ],
      "content": "草稿作废告知张书淮，不说条款；张书淮说不上话"
    },
    {
      "index": 9,
      "start_line": 467,
      "end_line": 505,
      "location": "回王府的马车上",
      "summary": "宵禁鼓响，邱思甜乘车回王府，护院一路盯着她。她在车灯下用铅笔把停战条款一条条默写进小本子，想起深澳问她一张纸挡得住谁。字迹没有签名印戳，谁也不认，可原件作废了，条款还在。",
      "characters": [
        "qiu_sitian",
        "wangfu_huyuan"
      ],
      "content": "马车里凭记性默写条款；原件作废，条款还在"
    }
  ],
